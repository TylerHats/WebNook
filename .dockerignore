# Dependencies (installed cleanly inside multi-stage Docker build for Alpine Linux)
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/dist/
frontend/dist/
build/

# Persistent runtime data & local databases (NEVER bake local dev data into release image)
backend/data/
backend/uploads/
backend/backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Environment & logs
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

